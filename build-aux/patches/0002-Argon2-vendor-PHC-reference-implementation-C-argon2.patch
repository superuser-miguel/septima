+# Argon2Test — validation for C/argon2 (vendored reference implementation)
+
+`C/argon2` is the PHC reference implementation, vendored **verbatim** (zero
+modifications) from the pinned release tarball:
+
+- `phc-winner-argon2` release `20190702`
+- sha256 `daf972a89577f8772602bf2eb38b6a3dd3d922bf5724d45e7f9589b5e830442c`
+  (matches the hash independently recorded by conan-center-index)
+- License: CC0 1.0 / Apache 2.0 dual (see `C/argon2/LICENSE`)
+
+Two test programs, each built against either fill path
+(`ref.c` portable, or `opt.c` SIMD — link exactly one):
+
+- `test.c` — upstream's own suite, verbatim from the same tarball
+- `argon2_kat.c` — self-checking RFC 9106 §5 known-answer tests
+  (argon2d / argon2i / argon2id full-parameter vectors with secret + AD;
+  expected tags extracted from rfc-editor.org text)
+
+```sh
+A2=../../argon2
+gcc -O2 -I $A2 argon2_kat.c $A2/argon2.c $A2/core.c $A2/ref.c \
+    $A2/encoding.c $A2/thread.c $A2/blake2/blake2b.c -lpthread -o argon2_kat
+./argon2_kat          # 3/3 PASS expected
+# same with test.c; add -mssse3 and swap ref.c -> opt.c for the SIMD path
+```
diff --git a/C/Util/Argon2Test/argon2_kat.c b/C/Util/Argon2Test/argon2_kat.c
new file mode 100644
index 00000000..27e22379
--- /dev/null
+++ b/C/Util/Argon2Test/argon2_kat.c
@@ -0,0 +1,68 @@
+/* argon2_kat.c -- self-checking RFC 9106 §5 known-answer tests for C/argon2.
+   Params per RFC: t=3, m=32 KiB, p=4, pwd=32x01, salt=16x02, secret=8x03,
+   ad=12x04, 32-byte tag. Expected tags extracted verbatim from
+   https://www.rfc-editor.org/rfc/rfc9106.txt (§5.1 argon2d, §5.2 argon2i,
+   §5.3 argon2id). Exits 0 only if all three match. */
+#include <stdio.h>
+#include <string.h>
+
+#include "argon2.h"
+
+static const char * const k_expected[3] = {
+  /* 5.1 Argon2d */
+  "512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb",
+  /* 5.2 Argon2i */
+  "c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8",
+  /* 5.3 Argon2id */
+  "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"
+};
+
+static int run(argon2_type type, const char *name, const char *expected)
+{
+  unsigned char out[32], pwd[32], salt[16], secret[8], ad[12];
+  char hex[65];
+  argon2_context c;
+  int rc, i;
+
+  memset(pwd, 0x01, sizeof(pwd));
+  memset(salt, 0x02, sizeof(salt));
+  memset(secret, 0x03, sizeof(secret));
+  memset(ad, 0x04, sizeof(ad));
+  memset(&c, 0, sizeof(c));
+  c.out = out; c.outlen = 32;
+  c.pwd = pwd; c.pwdlen = 32;
+  c.salt = salt; c.saltlen = 16;
+  c.secret = secret; c.secretlen = 8;
+  c.ad = ad; c.adlen = 12;
+  c.t_cost = 3;
+  c.m_cost = 32;
+  c.lanes = 4;
+  c.threads = 4;
+  c.version = ARGON2_VERSION_13;
+  c.flags = ARGON2_DEFAULT_FLAGS;
+
+  rc = argon2_ctx(&c, type);
+  if (rc != ARGON2_OK)
+  {
+    printf("%s: ERROR %s\n", name, argon2_error_message(rc));
+    return 1;
+  }
+  for (i = 0; i < 32; i++)
+    sprintf(hex + i * 2, "%02x", out[i]);
+  if (strcmp(hex, expected) != 0)
+  {
+    printf("%s: FAIL\n  got      %s\n  expected %s\n", name, hex, expected);
+    return 1;
+  }
+  printf("%s: PASS (%s)\n", name, hex);
+  return 0;
+}
+
+int main(void)
+{
+  int fails = 0;
+  fails += run(Argon2_d,  "argon2d  (RFC 9106 5.1)", k_expected[0]);
+  fails += run(Argon2_i,  "argon2i  (RFC 9106 5.2)", k_expected[1]);
+  fails += run(Argon2_id, "argon2id (RFC 9106 5.3)", k_expected[2]);
+  return fails ? 1 : 0;
+}
