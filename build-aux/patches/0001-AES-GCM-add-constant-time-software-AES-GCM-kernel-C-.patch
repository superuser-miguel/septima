+/* AesGcm.c -- AES-GCM authenticated encryption (NIST SP 800-38D)
+   Part of the Septima encryption expansion patch series.
+
+   The GHASH core (bmul64, rev64, Ghash_CtMul64) is adapted line-for-line from
+   BearSSL src/hash/ghash_ctmul64.c (constant-time: integer multiplications
+   with spaced bits, no secret-dependent table lookups or branches):
+
+   Copyright (c) 2016 Thomas Pornin <pornin@bolet.org>
+
+   Permission is hereby granted, free of charge, to any person obtaining
+   a copy of this software and associated documentation files (the
+   "Software"), to deal in the Software without restriction, including
+   without limitation the rights to use, copy, modify, merge, publish,
+   distribute, sublicense, and/or sell copies of the Software, and to
+   permit persons to whom the Software is furnished to do so, subject to
+   the following conditions:
+
+   The above copyright notice and this permission notice shall be
+   included in all copies or substantial portions of the Software.
+
+   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
+   EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+   BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+   ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+   SOFTWARE.
+
+   Changes vs BearSSL: 7-Zip types (UInt64/Byte), 7-Zip endian macros
+   (GetBe64/SetBe64), whitespace. No logic changes. */
+
+#include "Precomp.h"
+
+#include <string.h>
+
+#include "CpuArch.h"
+#include "AesGcm.h"
+
+/* ---- GHASH (BearSSL ghash_ctmul64) ---- */
+
+static UInt64 Bmul64(UInt64 x, UInt64 y)
+{
+  UInt64 x0, x1, x2, x3;
+  UInt64 y0, y1, y2, y3;
+  UInt64 z0, z1, z2, z3;
+
+  x0 = x & (UInt64)0x1111111111111111;
+  x1 = x & (UInt64)0x2222222222222222;
+  x2 = x & (UInt64)0x4444444444444444;
+  x3 = x & (UInt64)0x8888888888888888;
+  y0 = y & (UInt64)0x1111111111111111;
+  y1 = y & (UInt64)0x2222222222222222;
+  y2 = y & (UInt64)0x4444444444444444;
+  y3 = y & (UInt64)0x8888888888888888;
+  z0 = (x0 * y0) ^ (x1 * y3) ^ (x2 * y2) ^ (x3 * y1);
+  z1 = (x0 * y1) ^ (x1 * y0) ^ (x2 * y3) ^ (x3 * y2);
+  z2 = (x0 * y2) ^ (x1 * y1) ^ (x2 * y0) ^ (x3 * y3);
+  z3 = (x0 * y3) ^ (x1 * y2) ^ (x2 * y1) ^ (x3 * y0);
+  z0 &= (UInt64)0x1111111111111111;
+  z1 &= (UInt64)0x2222222222222222;
+  z2 &= (UInt64)0x4444444444444444;
+  z3 &= (UInt64)0x8888888888888888;
+  return z0 | z1 | z2 | z3;
+}
+
+static UInt64 Rev64(UInt64 x)
+{
+#define RMS(m, s)   do { \
+    x = ((x & (UInt64)(m)) << (s)) \
+      | ((x >> (s)) & (UInt64)(m)); \
+  } while (0)
+
+  RMS(0x5555555555555555,  1);
+  RMS(0x3333333333333333,  2);
+  RMS(0x0F0F0F0F0F0F0F0F,  4);
+  RMS(0x00FF00FF00FF00FF,  8);
+  RMS(0x0000FFFF0000FFFF, 16);
+  return (x << 32) | (x >> 32);
+
+#undef RMS
+}
+
+/* y <- (y ^ data) * H, over the full input; a trailing partial block
+   is zero-padded, which matches GCM's padding rule. */
+static void Ghash_CtMul64(Byte *y, const Byte *h, const Byte *data, size_t len)
+{
+  const Byte *buf, *hb;
+  Byte *yb;
+  UInt64 y0, y1;
+  UInt64 h0, h1, h2, h0r, h1r, h2r;
+
+  buf = data;
+  yb = y;
+  hb = h;
+  y1 = GetBe64(yb);
+  y0 = GetBe64(yb + 8);
+  h1 = GetBe64(hb);
+  h0 = GetBe64(hb + 8);
+  h0r = Rev64(h0);
+  h1r = Rev64(h1);
+  h2 = h0 ^ h1;
+  h2r = h0r ^ h1r;
+  while (len > 0)
+  {
+    const Byte *src;
+    Byte tmp[16];
+    UInt64 y0r, y1r, y2, y2r;
+    UInt64 z0, z1, z2, z0h, z1h, z2h;
+    UInt64 v0, v1, v2, v3;
+
+    if (len >= 16)
+    {
+      src = buf;
+      buf += 16;
+      len -= 16;
+    }
+    else
+    {
+      memcpy(tmp, buf, len);
+      memset(tmp + len, 0, (sizeof tmp) - len);
+      src = tmp;
+      len = 0;
+    }
+    y1 ^= GetBe64(src);
+    y0 ^= GetBe64(src + 8);
+
+    y0r = Rev64(y0);
+    y1r = Rev64(y1);
+    y2 = y0 ^ y1;
+    y2r = y0r ^ y1r;
+
+    z0 = Bmul64(y0, h0);
+    z1 = Bmul64(y1, h1);
+    z2 = Bmul64(y2, h2);
+    z0h = Bmul64(y0r, h0r);
+    z1h = Bmul64(y1r, h1r);
+    z2h = Bmul64(y2r, h2r);
+    z2 ^= z0 ^ z1;
+    z2h ^= z0h ^ z1h;
+    z0h = Rev64(z0h) >> 1;
+    z1h = Rev64(z1h) >> 1;
+    z2h = Rev64(z2h) >> 1;
+
+    v0 = z0;
+    v1 = z0h ^ z2;
+    v2 = z1 ^ z2h;
+    v3 = z1h;
+
+    v3 = (v3 << 1) | (v2 >> 63);
+    v2 = (v2 << 1) | (v1 >> 63);
+    v1 = (v1 << 1) | (v0 >> 63);
+    v0 = (v0 << 1);
+
+    v2 ^= v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 >> 7);
+    v1 ^= (v0 << 63) ^ (v0 << 62) ^ (v0 << 57);
+    v3 ^= v1 ^ (v1 >> 1) ^ (v1 >> 2) ^ (v1 >> 7);
+    v2 ^= (v1 << 63) ^ (v1 << 62) ^ (v1 << 57);
+
+    y0 = v2;
+    y1 = v3;
+  }
+
+  SetBe64(yb, y1)
+  SetBe64(yb + 8, y0)
+}
+
+/* ---- AES-GCM ---- */
+
+/* single-block AES-ECB over byte blocks (word layout matches AesCbc/AesCtr) */
+static void AesGcm_EncBlock(const UInt32 *aes, const Byte *src, Byte *dest)
+{
+  MY_ALIGN(16) UInt32 in[4];
+  MY_ALIGN(16) UInt32 out[4];
+  in[0] = GetUi32(src);
+  in[1] = GetUi32(src + 4);
+  in[2] = GetUi32(src + 8);
+  in[3] = GetUi32(src + 12);
+  Aes_Enc_Block(aes, out, in);
+  SetUi32(dest,      out[0])
+  SetUi32(dest + 4,  out[1])
+  SetUi32(dest + 8,  out[2])
+  SetUi32(dest + 12, out[3])
+}
+
+static void AesGcm_Inc32(Byte *ctr)
+{
+  const UInt32 c = GetBe32(ctr + 12) + 1;
+  SetBe32(ctr + 12, c)
+}
+
+void AesGcm_SetKey(CAesGcm *p, const Byte *key, unsigned keySize)
+{
+  Byte zero[AES_BLOCK_SIZE];
+  memset(zero, 0, sizeof(zero));
+  Aes_SetKey_Enc(p->aes, key, keySize);
+  AesGcm_EncBlock(p->aes, zero, p->h);
+}
+
+int AesGcm_Start(CAesGcm *p, const Byte *iv, size_t ivLen)
+{
+  p->ksPos = AES_BLOCK_SIZE;
+  p->bufPos = 0;
+  p->aadPhase = 1;
+  p->aadLen = 0;
+  p->dataLen = 0;
+  memset(p->y, 0, AES_BLOCK_SIZE);
+
+  if (ivLen == 0)
+    return 1;
+  if (ivLen == AES_GCM_IV_SIZE_DEFAULT)
+  {
+    memcpy(p->j0, iv, AES_GCM_IV_SIZE_DEFAULT);
+    p->j0[12] = 0;
+    p->j0[13] = 0;
+    p->j0[14] = 0;
+    p->j0[15] = 1;
+  }
+  else
+  {
+    Byte lenBlock[AES_BLOCK_SIZE];
+    memset(p->j0, 0, AES_BLOCK_SIZE);
+    Ghash_CtMul64(p->j0, p->h, iv, ivLen);
+    memset(lenBlock, 0, 8);
+    SetBe64(lenBlock + 8, (UInt64)ivLen * 8)
+    Ghash_CtMul64(p->j0, p->h, lenBlock, AES_BLOCK_SIZE);
+  }
+  memcpy(p->ctr, p->j0, AES_BLOCK_SIZE);
+  return 0;
+}
+
+/* streams data into GHASH; only full blocks go to Ghash_CtMul64,
+   a partial block waits in buf until more data or an explicit flush */
+static void AesGcm_GhashUpdate(CAesGcm *p, const Byte *data, size_t size)
+{
+  if (p->bufPos != 0)
+  {
+    const size_t rem = AES_BLOCK_SIZE - p->bufPos;
+    const size_t n = (size < rem ? size : rem);
+    memcpy(p->buf + p->bufPos, data, n);
+    p->bufPos += (unsigned)n;
+    data += n;
+    size -= n;
+    if (p->bufPos != AES_BLOCK_SIZE)
+      return;
+    Ghash_CtMul64(p->y, p->h, p->buf, AES_BLOCK_SIZE);
+    p->bufPos = 0;
+  }
+  {
+    const size_t full = size & ~(size_t)(AES_BLOCK_SIZE - 1);
+    if (full != 0)
+    {
+      Ghash_CtMul64(p->y, p->h, data, full);
+      data += full;
+      size -= full;
+    }
+  }
+  if (size != 0)
+  {
+    memcpy(p->buf, data, size);
+    p->bufPos = (unsigned)size;
+  }
+}
+
+static void AesGcm_GhashFlush(CAesGcm *p)
+{
+  if (p->bufPos != 0)
+  {
+    /* Ghash_CtMul64 zero-pads the partial block (GCM padding rule) */
+    Ghash_CtMul64(p->y, p->h, p->buf, p->bufPos);
+    p->bufPos = 0;
+  }
+}
+
+void AesGcm_UpdateAad(CAesGcm *p, const Byte *data, size_t size)
+{
+  p->aadLen += size;
+  AesGcm_GhashUpdate(p, data, size);
+}
+
+static void AesGcm_EndAad(CAesGcm *p)
+{
+  if (p->aadPhase)
+  {
+    AesGcm_GhashFlush(p);
+    p->aadPhase = 0;
+  }
+}
+
+static void AesGcm_Ctr(CAesGcm *p, Byte *data, size_t size)
+{
+  while (size != 0)
+  {
+    size_t n;
+    if (p->ksPos == AES_BLOCK_SIZE)
+    {
+      AesGcm_Inc32(p->ctr);
+      AesGcm_EncBlock(p->aes, p->ctr, p->ks);
+      p->ksPos = 0;
+    }
+    n = AES_BLOCK_SIZE - p->ksPos;
+    if (n > size)
+      n = size;
+    {
+      const Byte *ks = p->ks + p->ksPos;
+      size_t i;
+      for (i = 0; i < n; i++)
+        data[i] = (Byte)(data[i] ^ ks[i]);
+    }
+    data += n;
+    size -= n;
+    p->ksPos += (unsigned)n;
+  }
+}
+
+void AesGcm_Encrypt(CAesGcm *p, Byte *data, size_t size)
+{
+  AesGcm_EndAad(p);
+  p->dataLen += size;
+  AesGcm_Ctr(p, data, size);
+  AesGcm_GhashUpdate(p, data, size); /* GHASH over ciphertext */
+}
+
+void AesGcm_Decrypt(CAesGcm *p, Byte *data, size_t size)
+{
+  AesGcm_EndAad(p);
+  p->dataLen += size;
+  AesGcm_GhashUpdate(p, data, size); /* GHASH over ciphertext */
+  AesGcm_Ctr(p, data, size);
+}
+
+void AesGcm_GetTag(CAesGcm *p, Byte *tag)
+{
+  Byte lenBlock[AES_BLOCK_SIZE];
+  Byte ekj0[AES_BLOCK_SIZE];
+  unsigned i;
+
+  AesGcm_EndAad(p);
+  AesGcm_GhashFlush(p);
+  SetBe64(lenBlock,     p->aadLen * 8)
+  SetBe64(lenBlock + 8, p->dataLen * 8)
+  Ghash_CtMul64(p->y, p->h, lenBlock, AES_BLOCK_SIZE);
+  AesGcm_EncBlock(p->aes, p->j0, ekj0);
+  for (i = 0; i < AES_GCM_TAG_SIZE; i++)
+    tag[i] = (Byte)(ekj0[i] ^ p->y[i]);
+}
+
+unsigned AesGcm_IsTagEqual_CT(const Byte *tag1, const Byte *tag2)
+{
+  unsigned d = 0;
+  unsigned i;
+  for (i = 0; i < AES_GCM_TAG_SIZE; i++)
+    d |= (unsigned)(tag1[i] ^ tag2[i]);
+  return (unsigned)((d - 1) >> 8) & 1;
+}
+
+void AesGcm_Wipe(CAesGcm *p)
+{
+  volatile Byte *pb = (volatile Byte *)p;
+  size_t size = sizeof(*p);
+  while (size--)
+    *pb++ = 0;
+}
diff --git a/C/AesGcm.h b/C/AesGcm.h
new file mode 100644
index 00000000..cf07be38
--- /dev/null
+++ b/C/AesGcm.h
@@ -0,0 +1,59 @@
+/* AesGcm.h -- AES-GCM authenticated encryption (NIST SP 800-38D)
+   Part of the Septima encryption expansion patch series.
+   Streaming interface over the in-tree AES kernels (Aes.c).
+   GHASH is the constant-time ctmul64 implementation from BearSSL
+   (c) 2016 Thomas Pornin <pornin@bolet.org>, MIT license — see AesGcm.c. */
+
+#ifndef ZIP7_INC_AES_GCM_H
+#define ZIP7_INC_AES_GCM_H
+
+#include "Aes.h"
+
+EXTERN_C_BEGIN
+
+#define AES_GCM_TAG_SIZE 16
+#define AES_GCM_IV_SIZE_DEFAULT 12
+
+/* Call AesGenTables() once before any use (same rule as the other AES functions). */
+
+typedef struct
+{
+  MY_ALIGN(16) UInt32 aes[(1 + 15) * 4]; /* keyMode + round keys (Aes_SetKey_Enc layout) */
+  Byte h[AES_BLOCK_SIZE];      /* GHASH key: E_K(0^128) */
+  Byte y[AES_BLOCK_SIZE];      /* GHASH accumulator */
+  Byte j0[AES_BLOCK_SIZE];     /* pre-counter block; E_K(j0) masks the tag */
+  Byte ctr[AES_BLOCK_SIZE];    /* current counter block (inc32 semantics) */
+  Byte ks[AES_BLOCK_SIZE];     /* current keystream block */
+  Byte buf[AES_BLOCK_SIZE];    /* partial GHASH input block */
+  unsigned ksPos;              /* consumed keystream bytes; AES_BLOCK_SIZE == empty */
+  unsigned bufPos;
+  int aadPhase;
+  UInt64 aadLen;               /* bytes */
+  UInt64 dataLen;              /* bytes */
+} CAesGcm;
+
+/* keySize = 16, 24 or 32 (bytes) */
+void AesGcm_SetKey(CAesGcm *p, const Byte *key, unsigned keySize);
+
+/* starts a new message under the current key; any ivLen >= 1 per SP 800-38D
+   (12 is the standard fast path). Returns 0 on success, 1 on bad ivLen. */
+int AesGcm_Start(CAesGcm *p, const Byte *iv, size_t ivLen);
+
+/* all AAD must be supplied before the first Encrypt/Decrypt call */
+void AesGcm_UpdateAad(CAesGcm *p, const Byte *data, size_t size);
+
+/* in-place, arbitrary chunk sizes across calls */
+void AesGcm_Encrypt(CAesGcm *p, Byte *data, size_t size);
+void AesGcm_Decrypt(CAesGcm *p, Byte *data, size_t size);
+
+/* call once, after all data; tag is AES_GCM_TAG_SIZE bytes */
+void AesGcm_GetTag(CAesGcm *p, Byte *tag);
+
+/* constant-time; returns 1 if equal, 0 otherwise */
+unsigned AesGcm_IsTagEqual_CT(const Byte *tag1, const Byte *tag2);
+
+void AesGcm_Wipe(CAesGcm *p);
+
+EXTERN_C_END
+
+#endif
