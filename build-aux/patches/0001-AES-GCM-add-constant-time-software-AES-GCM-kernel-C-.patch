+# AesGcmTest — cross-validation harness for C/AesGcm.c
+
+Validates the streaming AES-GCM kernel against OpenSSL (via python-cryptography):
+edge cases plus 3000 random vectors — AES-128/192/256, IV lengths 8..128 bytes,
+AAD, ragged streaming chunk sizes, round-trip decryption, tamper rejection.
+
+```sh
+gcc -O2 -Wall -Wextra -I ../../ gcmtest.c \
+    ../../AesGcm.c ../../Aes.c ../../AesOpt.c ../../CpuArch.c -o gcmtest
+python3 gcm_oracle.py     # runs ./gcmtest, prints N/N vectors passed
+```
diff --git a/C/Util/AesGcmTest/gcm_oracle.py b/C/Util/AesGcmTest/gcm_oracle.py
new file mode 100644
index 00000000..439c42ba
--- /dev/null
+++ b/C/Util/AesGcmTest/gcm_oracle.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Cross-check C/AesGcm.c against python-cryptography (OpenSSL AES-GCM).
+
+Feeds vectors to ./gcmtest via stdin, compares ct/tag with AESGCM output.
+Includes edge cases + N random vectors (keys 128/192/256, IV lens 12 and odd).
+"""
+import os
+import random
+import subprocess
+import sys
+
+from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+
+N_RANDOM = 3000
+random.seed(0x5E971A)  # deterministic
+
+def oracle(key: bytes, iv: bytes, aad: bytes, pt: bytes):
+    enc = Cipher(algorithms.AES(key), modes.GCM(iv)).encryptor()
+    enc.authenticate_additional_data(aad)
+    ct = enc.update(pt) + enc.finalize()
+    return ct, enc.tag
+
+def h(b: bytes) -> str:
+    return b.hex() if b else "-"
+
+vectors = []
+
+# --- edge cases ---
+Z = bytes
+edge_keys = [bytes(16), bytes(24), bytes(32), bytes(range(32))]
+for key in edge_keys:
+    vectors.append((key, bytes(12), b"", b""))                      # all-zero, empty
+    vectors.append((key, bytes(12), b"", bytes(16)))                # single block
+    vectors.append((key, bytes(12), b"\xab" * 20, b""))             # AAD only
+    vectors.append((key, bytes(12), b"", b"\x01"))                  # 1 byte
+    vectors.append((key, bytes(12), b"", bytes(15)))                # partial block
+    vectors.append((key, bytes(12), b"", bytes(17)))                # block + 1
+    vectors.append((key, bytes(8), b"", bytes(16)))                 # non-96-bit IV
+    vectors.append((key, bytes(60), b"\x02" * 16, bytes(64)))       # long IV
+    vectors.append((key, bytes(range(1, 13)), b"\x03" * 15, bytes(255)))
+
+# --- random vectors ---
+for _ in range(N_RANDOM):
+    key = random.randbytes(random.choice([16, 24, 32]))
+    ivlen = random.choice([12, 12, 12, 8, 13, 16, 32, 120, 128])
+    iv = random.randbytes(ivlen)
+    aad = random.randbytes(random.randrange(0, 90))
+    pt = random.randbytes(random.randrange(0, 700))
+    vectors.append((key, iv, aad, pt))
+
+lines = "".join(f"{h(k)} {h(i)} {h(a)} {h(p)}\n" for k, i, a, p in vectors)
+proc = subprocess.run([os.path.join(os.path.dirname(__file__) or ".", "gcmtest")],
+                      input=lines, capture_output=True, text=True)
+if proc.returncode != 0:
+    sys.exit(f"gcmtest crashed: rc={proc.returncode}\n{proc.stderr}")
+
+out = proc.stdout.strip().splitlines()
+if len(out) != len(vectors):
+    sys.exit(f"line count mismatch: {len(out)} != {len(vectors)}")
+
+fails = 0
+for idx, ((key, iv, aad, pt), line) in enumerate(zip(vectors, out)):
+    parts = line.split()
+    if parts[0] != "OK":
+        print(f"[{idx}] C-side failure: {line}  "
+              f"(key={len(key)*8} iv={len(iv)} aad={len(aad)} pt={len(pt)})")
+        fails += 1
+        continue
+    ct_hex = "" if parts[1] == "-" else parts[1]
+    tag_hex = parts[2]
+    ct_ref, tag_ref = oracle(key, iv, aad, pt)
+    if ct_hex != ct_ref.hex() or tag_hex != tag_ref.hex():
+        print(f"[{idx}] MISMATCH key={key.hex()} iv={iv.hex()} "
+              f"aad={aad.hex()} pt={pt.hex()}")
+        print(f"  got ct={ct_hex} tag={tag_hex}")
+        print(f"  ref ct={ct_ref.hex()} tag={tag_ref.hex()}")
+        fails += 1
+
+print(f"{len(vectors) - fails}/{len(vectors)} vectors passed "
+      f"({len(edge_keys) * 9} edge + {N_RANDOM} random)")
+sys.exit(1 if fails else 0)
diff --git a/C/Util/AesGcmTest/gcmtest.c b/C/Util/AesGcmTest/gcmtest.c
new file mode 100644
index 00000000..5104b601
--- /dev/null
+++ b/C/Util/AesGcmTest/gcmtest.c
@@ -0,0 +1,171 @@
+/* gcmtest.c -- stdin/stdout test driver for C/AesGcm.c
+   Input lines:  <keyhex> <ivhex> <aadhex|-> <pthex|->
+   Output lines: OK <cthex|-> <taghex>
+   or:           FAIL <reason>
+   Encryption is streamed through awkward chunk sizes; the result is then
+   decrypted (different chunk sizes) and round-trip + tamper checks run. */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "AesGcm.h"
+
+static int HexVal(int c)
+{
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+  return -1;
+}
+
+/* "-" means empty; returns length or -1 */
+static int ParseHex(const char *s, Byte *out, int maxLen)
+{
+  int len = 0;
+  if (strcmp(s, "-") == 0)
+    return 0;
+  while (s[0] && s[1])
+  {
+    int hi = HexVal(s[0]), lo = HexVal(s[1]);
+    if (hi < 0 || lo < 0 || len >= maxLen)
+      return -1;
+    out[len++] = (Byte)((hi << 4) | lo);
+    s += 2;
+  }
+  if (s[0])
+    return -1;
+  return len;
+}
+
+static void PrintHex(const Byte *p, int len)
+{
+  if (len == 0)
+    printf("-");
+  else
+  {
+    int i;
+    for (i = 0; i < len; i++)
+      printf("%02x", p[i]);
+  }
+}
+
+static const size_t chunksA[] = { 1, 7, 16, 3, 32, 5, 13, 64, 2, 17 };
+static const size_t chunksB[] = { 4, 1, 29, 16, 8, 47, 1, 3, 128, 11 };
+
+typedef void (*GCM_UPDATE)(CAesGcm *p, Byte *data, size_t size);
+
+static void FeedChunks(CAesGcm *g, GCM_UPDATE f, Byte *data, size_t len,
+    const size_t *pattern, size_t patternLen)
+{
+  size_t pos = 0, k = 0;
+  while (pos < len)
+  {
+    size_t n = pattern[k % patternLen];
+    k++;
+    if (n > len - pos)
+      n = len - pos;
+    f(g, data + pos, n);
+    pos += n;
+  }
+}
+
+static void FeedAadChunks(CAesGcm *g, const Byte *data, size_t len)
+{
+  size_t pos = 0, k = 0;
+  while (pos < len)
+  {
+    size_t n = chunksB[k % (sizeof(chunksB) / sizeof(chunksB[0]))];
+    k++;
+    if (n > len - pos)
+      n = len - pos;
+    AesGcm_UpdateAad(g, data + pos, n);
+    pos += n;
+  }
+}
+
+#define MAX_BUF (1 << 16)
+
+int main(void)
+{
+  static char line[5 * MAX_BUF];
+  static Byte key[64], iv[256], aad[MAX_BUF], data[MAX_BUF], orig[MAX_BUF];
+  AesGenTables();
+
+  while (fgets(line, sizeof(line), stdin))
+  {
+    char *sKey, *sIv, *sAad, *sPt, *save = NULL;
+    int keyLen, ivLen, aadLen, ptLen;
+    CAesGcm g;
+    Byte tag[AES_GCM_TAG_SIZE], tag2[AES_GCM_TAG_SIZE];
+
+    if (line[0] == '\n' || line[0] == '#')
+      continue;
+    sKey = strtok_r(line, " \t\n", &save);
+    sIv  = strtok_r(NULL, " \t\n", &save);
+    sAad = strtok_r(NULL, " \t\n", &save);
+    sPt  = strtok_r(NULL, " \t\n", &save);
+    if (!sKey || !sIv || !sAad || !sPt)
+      { printf("FAIL parse\n"); continue; }
+
+    keyLen = ParseHex(sKey, key, sizeof(key));
+    ivLen  = ParseHex(sIv, iv, sizeof(iv));
+    aadLen = ParseHex(sAad, aad, sizeof(aad));
+    ptLen  = ParseHex(sPt, data, sizeof(data));
+    if (keyLen <= 0 || ivLen <= 0 || aadLen < 0 || ptLen < 0)
+      { printf("FAIL hex\n"); continue; }
+    memcpy(orig, data, (size_t)ptLen);
+
+    /* encrypt (streamed) */
+    AesGcm_SetKey(&g, key, (unsigned)keyLen);
+    if (AesGcm_Start(&g, iv, (size_t)ivLen))
+      { printf("FAIL start\n"); continue; }
+    FeedAadChunks(&g, aad, (size_t)aadLen);
+    FeedChunks(&g, AesGcm_Encrypt, data, (size_t)ptLen,
+        chunksA, sizeof(chunksA) / sizeof(chunksA[0]));
+    AesGcm_GetTag(&g, tag);
+
+    /* round-trip decrypt with different chunking */
+    {
+      static Byte ct[MAX_BUF];
+      memcpy(ct, data, (size_t)ptLen);
+      AesGcm_Start(&g, iv, (size_t)ivLen);
+      FeedAadChunks(&g, aad, (size_t)aadLen);
+      FeedChunks(&g, AesGcm_Decrypt, ct, (size_t)ptLen,
+          chunksB, sizeof(chunksB) / sizeof(chunksB[0]));
+      AesGcm_GetTag(&g, tag2);
+      if (!AesGcm_IsTagEqual_CT(tag, tag2))
+        { printf("FAIL rt-tag\n"); continue; }
+      if (ptLen && memcmp(ct, orig, (size_t)ptLen) != 0)
+        { printf("FAIL rt-data\n"); continue; }
+
+      /* tamper: flip one ciphertext byte (or the tag if empty) -> must not verify */
+      AesGcm_Start(&g, iv, (size_t)ivLen);
+      FeedAadChunks(&g, aad, (size_t)aadLen);
+      if (ptLen)
+      {
+        memcpy(ct, data, (size_t)ptLen);
+        ct[ptLen / 2] ^= 0x40;
+        AesGcm_Decrypt(&g, ct, (size_t)ptLen);
+        AesGcm_GetTag(&g, tag2);
+        if (AesGcm_IsTagEqual_CT(tag, tag2))
+          { printf("FAIL tamper-accepted\n"); continue; }
+      }
+      else
+      {
+        AesGcm_GetTag(&g, tag2);
+        tag2[0] ^= 1;
+        if (AesGcm_IsTagEqual_CT(tag, tag2))
+          { printf("FAIL tamper-accepted\n"); continue; }
+      }
+    }
+
+    printf("OK ");
+    PrintHex(data, ptLen);
+    printf(" ");
+    PrintHex(tag, AES_GCM_TAG_SIZE);
+    printf("\n");
+    AesGcm_Wipe(&g);
+  }
+  return 0;
+}
