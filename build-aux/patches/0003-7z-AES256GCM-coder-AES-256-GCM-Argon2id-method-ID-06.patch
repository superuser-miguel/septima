+++ b/CPP/7zip/Crypto/7zGcm.cpp
@@ -0,0 +1,344 @@
+// 7zGcm.cpp -- AES-256-GCM + Argon2id coder for 7z archives
+// (Septima encryption expansion; standards-only: RFC 9106 + NIST SP 800-38D)
+//
+// Coder properties layout (written by CEncoder, all integers little-endian):
+//   Byte  0      props format version (1)
+//   Byte  1      KDF id (1 = Argon2id, version 0x13)
+//   Bytes 2..5   Argon2 m_cost, KiB (UInt32)
+//   Bytes 6..9   Argon2 t_cost / passes (UInt32)
+//   Bytes 10..13 Argon2 lanes (UInt32)
+//   Byte  14     salt size (encoder writes 16; decoder accepts 8..32)
+//   Byte  15     iv size   (encoder writes 12; decoder accepts 1..16)
+//   then salt, then iv
+// The pack stream is: ciphertext || 16-byte GCM tag.
+// The password bytes (UTF-16LE, as delivered by ICryptoSetPassword) are the
+// Argon2id password input; the derived 32-byte key is the AES-256-GCM key.
+
+#include "StdAfx.h"
+
+#include "../../../C/CpuArch.h"
+#include "../../../C/argon2/argon2.h"
+
+#include "../../Common/ComTry.h"
+#include "../../Common/MyBuffer2.h"
+
+#ifndef Z7_ST
+#include "../../Windows/Synchronization.h"
+#endif
+
+#include "../Common/StreamUtils.h"
+
+#include "7zGcm.h"
+
+#ifndef Z7_EXTRACT_ONLY
+#include "RandGen.h"
+#endif
+
+namespace NCrypto {
+namespace N7zGcm {
+
+bool CKeyInfo::IsEqualTo(const CKeyInfo &a) const
+{
+  if (Mem_KiB != a.Mem_KiB || Iters != a.Iters || Lanes != a.Lanes
+      || SaltSize != a.SaltSize)
+    return false;
+  for (unsigned i = 0; i < SaltSize; i++)
+    if (Salt[i] != a.Salt[i])
+      return false;
+  return (Password == a.Password);
+}
+
+HRESULT CKeyInfo::CalcKey()
+{
+  argon2_context c;
+  memset(&c, 0, sizeof(c));
+  c.out = Key;
+  c.outlen = kKeySize;
+  c.pwd = (uint8_t *)(Byte *)Password;
+  c.pwdlen = (uint32_t)Password.Size();
+  c.salt = Salt;
+  c.saltlen = (uint32_t)SaltSize;
+  c.t_cost = Iters;
+  c.m_cost = Mem_KiB;
+  c.lanes = Lanes;
+  c.threads = Lanes;
+  c.version = ARGON2_VERSION_13;
+  c.flags = ARGON2_DEFAULT_FLAGS;
+
+  int rc = argon2_ctx(&c, Argon2_id);
+  if (rc == ARGON2_THREAD_FAIL)
+  {
+    // same result is defined by lanes, not by thread count
+    c.threads = 1;
+    rc = argon2_ctx(&c, Argon2_id);
+  }
+  if (rc == ARGON2_OK)
+    return S_OK;
+  if (rc == ARGON2_MEMORY_ALLOCATION_ERROR)
+    return E_OUTOFMEMORY;
+  return E_FAIL;
+}
+
+bool CKeyInfoCache::GetKey(CKeyInfo &key)
+{
+  FOR_VECTOR (i, Keys)
+  {
+    const CKeyInfo &cached = Keys[i];
+    if (key.IsEqualTo(cached))
+    {
+      for (unsigned j = 0; j < kKeySize; j++)
+        key.Key[j] = cached.Key[j];
+      if (i != 0)
+        Keys.MoveToFront(i);
+      return true;
+    }
+  }
+  return false;
+}
+
+void CKeyInfoCache::FindAndAdd(const CKeyInfo &key)
+{
+  FOR_VECTOR (i, Keys)
+  {
+    const CKeyInfo &cached = Keys[i];
+    if (key.IsEqualTo(cached))
+    {
+      if (i != 0)
+        Keys.MoveToFront(i);
+      return;
+    }
+  }
+  Add(key);
+}
+
+void CKeyInfoCache::Add(const CKeyInfo &key)
+{
+  if (Keys.Size() >= Size)
+    Keys.DeleteBack();
+  Keys.Insert(0, key);
+}
+
+static CKeyInfoCache g_GlobalKeyCache(16);
+
+#ifndef Z7_ST
+  static NWindows::NSynchronization::CCriticalSection g_GlobalKeyCacheCriticalSection;
+  #define MT_LOCK NWindows::NSynchronization::CCriticalSectionLock lock(g_GlobalKeyCacheCriticalSection);
+#else
+  #define MT_LOCK
+#endif
+
+CBaseCoder::CBaseCoder():
+    _cachedKeys(4),
+    _ivSize(0)
+{
+  for (unsigned i = 0; i < sizeof(_iv); i++)
+    _iv[i] = 0;
+  memset(&_gcm, 0, sizeof(_gcm));
+}
+
+CBaseCoder::~CBaseCoder()
+{
+  AesGcm_Wipe(&_gcm);
+}
+
+HRESULT CBaseCoder::PrepareKey()
+{
+  // Argon2id is expensive (default: 256 MiB, ~hundreds of ms), so the
+  // key cache is load-bearing here, not just an optimization.
+  MT_LOCK
+
+  bool found = false;
+  if (!_cachedKeys.GetKey(_key))
+  {
+    found = g_GlobalKeyCache.GetKey(_key);
+    if (!found)
+    {
+      RINOK(_key.CalcKey())
+    }
+    _cachedKeys.Add(_key);
+  }
+  if (!found)
+    g_GlobalKeyCache.FindAndAdd(_key);
+  return S_OK;
+}
+
+HRESULT CBaseCoder::InitCipher()
+{
+  if (_ivSize == 0)
+    return E_FAIL;
+  RINOK(PrepareKey())
+  AesGcm_SetKey(&_gcm, _key.Key, kKeySize);
+  if (AesGcm_Start(&_gcm, _iv, _ivSize))
+    return E_FAIL;
+  return S_OK;
+}
+
+Z7_COM7F_IMF(CBaseCoder::Code(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+    const UInt64 *inSize, const UInt64 *outSize, ICompressProgressInfo *progress))
+{
+  COM_TRY_BEGIN
+  return Code2(inStream, outStream, inSize, outSize, progress);
+  COM_TRY_END
+}
+
+Z7_COM7F_IMF(CBaseCoder::CryptoSetPassword(const Byte *data, UInt32 size))
+{
+  COM_TRY_BEGIN
+
+  _key.Password.Wipe();
+  _key.Password.CopyFrom(data, (size_t)size);
+  return S_OK;
+
+  COM_TRY_END
+}
+
+static const size_t kBufSize = (size_t)1 << 20;
+
+#ifndef Z7_EXTRACT_ONLY
+
+CEncoder::CEncoder()
+{
+  _key.SaltSize = kSaltSize;
+  MY_RAND_GEN(_key.Salt, kSaltSize);
+  _ivSize = kIvSize;
+  MY_RAND_GEN(_iv, _ivSize);
+}
+
+Z7_COM7F_IMF(CEncoder::ResetInitVector())
+{
+  _ivSize = kIvSize;
+  MY_RAND_GEN(_iv, _ivSize);
+  return S_OK;
+}
+
+Z7_COM7F_IMF(CEncoder::WriteCoderProperties(ISequentialOutStream *outStream))
+{
+  Byte props[16 + kSaltSize + kIvSize];
+  props[0] = 1;
+  props[1] = 1;
+  SetUi32(props + 2, _key.Mem_KiB)
+  SetUi32(props + 6, _key.Iters)
+  SetUi32(props + 10, _key.Lanes)
+  props[14] = (Byte)kSaltSize;
+  props[15] = (Byte)kIvSize;
+  memcpy(props + 16, _key.Salt, kSaltSize);
+  memcpy(props + 16 + kSaltSize, _iv, kIvSize);
+  return WriteStream(outStream, props, sizeof(props));
+}
+
+HRESULT CEncoder::Code2(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+    const UInt64 * /* inSize */, const UInt64 * /* outSize */, ICompressProgressInfo *progress)
+{
+  RINOK(InitCipher())
+  CAlignedBuffer1 buf(kBufSize);
+  UInt64 inTotal = 0, outTotal = 0;
+  for (;;)
+  {
+    size_t size = kBufSize;
+    RINOK(ReadStream(inStream, buf, &size))
+    if (size == 0)
+      break;
+    AesGcm_Encrypt(&_gcm, buf, size);
+    RINOK(WriteStream(outStream, buf, size))
+    inTotal += size;
+    outTotal += size;
+    if (progress)
+    {
+      RINOK(progress->SetRatioInfo(&inTotal, &outTotal))
+    }
+  }
+  Byte tag[kTagSize];
+  AesGcm_GetTag(&_gcm, tag);
+  return WriteStream(outStream, tag, kTagSize);
+}
+
+#endif
+
+CDecoder::CDecoder()
+{
+}
+
+Z7_COM7F_IMF(CDecoder::SetDecoderProperties2(const Byte *data, UInt32 size))
+{
+  _key.ClearProps();
+  _ivSize = 0;
+  for (unsigned i = 0; i < sizeof(_iv); i++)
+    _iv[i] = 0;
+
+  if (size < 16)
+    return E_INVALIDARG;
+  if (data[0] != 1 || data[1] != 1)
+    return E_NOTIMPL;
+
+  const UInt32 mem = GetUi32(data + 2);
+  const UInt32 iters = GetUi32(data + 6);
+  const UInt32 lanes = GetUi32(data + 10);
+  const unsigned saltSize = data[14];
+  const unsigned ivSize = data[15];
+
+  if (saltSize < 8 || saltSize > kSaltSizeMax
+      || ivSize < 1 || ivSize > kIvSizeMax)
+    return E_NOTIMPL;
+  if (size != 16 + saltSize + ivSize)
+    return E_INVALIDARG;
+  if (iters < 1 || iters > kItersMax
+      || lanes < 1 || lanes > kLanesMax
+      || mem > kMemMax_KiB || mem < 8 * lanes)
+    return E_NOTIMPL;
+
+  _key.Mem_KiB = mem;
+  _key.Iters = iters;
+  _key.Lanes = lanes;
+  _key.SaltSize = saltSize;
+  data += 16;
+  memcpy(_key.Salt, data, saltSize);
+  data += saltSize;
+  memcpy(_iv, data, ivSize);
+  _ivSize = ivSize;
+  return S_OK;
+}
+
+HRESULT CDecoder::Code2(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+    const UInt64 *inSize, const UInt64 *outSize, ICompressProgressInfo *progress)
+{
+  UInt64 dataSize;
+  if (inSize)
+  {
+    if (*inSize < kTagSize)
+      return S_FALSE;
+    dataSize = *inSize - kTagSize;
+    if (outSize && *outSize != dataSize)
+      return S_FALSE;
+  }
+  else if (outSize)
+    dataSize = *outSize;
+  else
+    return E_NOTIMPL;
+
+  RINOK(InitCipher())
+  CAlignedBuffer1 buf(kBufSize);
+  UInt64 inTotal = 0, outTotal = 0;
+  UInt64 rem = dataSize;
+  while (rem != 0)
+  {
+    const size_t size = (size_t)(rem < kBufSize ? rem : kBufSize);
+    RINOK(ReadStream_FALSE(inStream, buf, size))
+    AesGcm_Decrypt(&_gcm, buf, size);
+    RINOK(WriteStream(outStream, buf, size))
+    rem -= size;
+    inTotal += size;
+    outTotal += size;
+    if (progress)
+    {
+      RINOK(progress->SetRatioInfo(&inTotal, &outTotal))
+    }
+  }
+  Byte tagStored[kTagSize], tagCalced[kTagSize];
+  RINOK(ReadStream_FALSE(inStream, tagStored, kTagSize))
+  AesGcm_GetTag(&_gcm, tagCalced);
+  if (!AesGcm_IsTagEqual_CT(tagStored, tagCalced))
+    return S_FALSE;  // wrong password or corrupted data
+  return S_OK;
+}
+
+}}
diff --git a/CPP/7zip/Crypto/7zGcm.h b/CPP/7zip/Crypto/7zGcm.h
new file mode 100644
index 00000000..f4b75841
--- /dev/null
+++ b/CPP/7zip/Crypto/7zGcm.h
@@ -0,0 +1,146 @@
+// 7zGcm.h -- AES-256-GCM + Argon2id coder for 7z archives
+// (Septima encryption expansion; standards-only: RFC 9106 + NIST SP 800-38D)
+
+#ifndef ZIP7_INC_CRYPTO_7Z_GCM_H
+#define ZIP7_INC_CRYPTO_7Z_GCM_H
+
+#include "../../../C/AesGcm.h"
+
+#include "../../Common/MyBuffer.h"
+#include "../../Common/MyCom.h"
+#include "../../Common/MyVector.h"
+
+#include "../ICoder.h"
+#include "../IPassword.h"
+
+namespace NCrypto {
+namespace N7zGcm {
+
+const unsigned kKeySize = 32;
+const unsigned kSaltSize = 16;      // written by encoder
+const unsigned kSaltSizeMax = 32;   // accepted by decoder
+const unsigned kIvSize = AES_GCM_IV_SIZE_DEFAULT;  // 12, written by encoder
+const unsigned kIvSizeMax = 16;     // accepted by decoder
+const unsigned kTagSize = AES_GCM_TAG_SIZE;        // 16, appended to pack stream
+
+// Argon2id cost defaults (encode side)
+const UInt32 kMemDefault_KiB = (UInt32)1 << 18;  // 256 MiB
+const UInt32 kItersDefault = 3;
+const UInt32 kLanesDefault = 4;
+
+// decode-side ceilings, so a hostile header cannot demand absurd resources
+const UInt32 kMemMax_KiB = (UInt32)1 << 21;      // 2 GiB
+const UInt32 kItersMax = 64;
+const UInt32 kLanesMax = 64;
+
+class CKeyInfo
+{
+public:
+  UInt32 Mem_KiB;
+  UInt32 Iters;
+  UInt32 Lanes;
+  unsigned SaltSize;
+  Byte Salt[kSaltSizeMax];
+  CByteBuffer Password;
+  Byte Key[kKeySize];
+
+  bool IsEqualTo(const CKeyInfo &a) const;
+  HRESULT CalcKey();  // Argon2id (RFC 9106)
+
+  CKeyInfo() { ClearProps(); }
+  void ClearProps()
+  {
+    Mem_KiB = kMemDefault_KiB;
+    Iters = kItersDefault;
+    Lanes = kLanesDefault;
+    SaltSize = 0;
+    for (unsigned i = 0; i < sizeof(Salt); i++)
+      Salt[i] = 0;
+  }
+
+  void Wipe()
+  {
+    Password.Wipe();
+    ClearProps();
+    Z7_memset_0_ARRAY(Key);
+  }
+
+#ifdef Z7_CPP_IS_SUPPORTED_default
+  CKeyInfo(const CKeyInfo &) = default;
+#endif
+  ~CKeyInfo() { Wipe(); }
+};
+
+class CKeyInfoCache
+{
+  unsigned Size;
+  CObjectVector<CKeyInfo> Keys;
+public:
+  CKeyInfoCache(unsigned size): Size(size) {}
+  bool GetKey(CKeyInfo &key);
+  void Add(const CKeyInfo &key);
+  void FindAndAdd(const CKeyInfo &key);
+};
+
+class CBaseCoder:
+  public ICompressCoder,
+  public ICryptoSetPassword,
+  public CMyUnknownImp
+{
+  Z7_IFACE_COM7_IMP(ICompressCoder)
+  Z7_IFACE_COM7_IMP(ICryptoSetPassword)
+protected:
+  CKeyInfoCache _cachedKeys;
+  CKeyInfo _key;
+  unsigned _ivSize;
+  Byte _iv[kIvSizeMax];
+  CAesGcm _gcm;
+
+  CBaseCoder();
+  virtual ~CBaseCoder();
+  HRESULT PrepareKey();
+  HRESULT InitCipher();
+  virtual HRESULT Code2(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+      const UInt64 *inSize, const UInt64 *outSize, ICompressProgressInfo *progress) = 0;
+};
+
+#ifndef Z7_EXTRACT_ONLY
+
+class CEncoder Z7_final:
+  public CBaseCoder,
+  public ICompressWriteCoderProperties,
+  public ICryptoResetInitVector
+{
+  Z7_COM_UNKNOWN_IMP_4(
+      ICompressCoder,
+      ICryptoSetPassword,
+      ICompressWriteCoderProperties,
+      ICryptoResetInitVector)
+  Z7_IFACE_COM7_IMP(ICompressWriteCoderProperties)
+  Z7_IFACE_COM7_IMP(ICryptoResetInitVector)
+  virtual HRESULT Code2(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+      const UInt64 *inSize, const UInt64 *outSize, ICompressProgressInfo *progress) Z7_override;
+public:
+  CEncoder();
+};
+
+#endif
+
+class CDecoder Z7_final:
+  public CBaseCoder,
+  public ICompressSetDecoderProperties2
+{
+  Z7_COM_UNKNOWN_IMP_3(
+      ICompressCoder,
+      ICryptoSetPassword,
+      ICompressSetDecoderProperties2)
+  Z7_IFACE_COM7_IMP(ICompressSetDecoderProperties2)
+  virtual HRESULT Code2(ISequentialInStream *inStream, ISequentialOutStream *outStream,
+      const UInt64 *inSize, const UInt64 *outSize, ICompressProgressInfo *progress) Z7_override;
+public:
+  CDecoder();
+};
+
+}}
+
+#endif
