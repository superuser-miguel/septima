using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("_Extract Several Archives…");
      action: "win.batch-extract";
    }
  }

  section {
    item {
      label: _("Close Archive");
      action: "win.close-archive";
    }
  }

  section {
    item {
      label: _("Calculate Checksums…");
      action: "win.checksums";
    }

    item {
      label: _("Test Archive");
      action: "win.test-archive";
    }
  }

  section {
    item {
      label: _("_What Septima Can Do");
      action: "app.capabilities";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Septima");
      action: "app.about";
    }
  }
}

template $SeptimaWindow: Adw.ApplicationWindow {
  default-width: 900;
  default-height: 600;
  width-request: 360;
  height-request: 200;
  title: _("Septima");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Septima");
      };

      [start]
      Gtk.Button open_button {
        icon-name: "document-open-symbolic";
        tooltip-text: _("Open Archive");
        clicked => $on_open_clicked() swapped;
      }

      Gtk.Button new_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("New Archive");
        clicked => $on_new_clicked() swapped;
      }

      [end]
      Gtk.Button extract_button {
        label: _("Extract");
        sensitive: false;
        clicked => $on_extract_clicked() swapped;

        styles [
          "suggested-action",
        ]
      }

      [end]
      Gtk.MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }

    [bottom]
    Gtk.Revealer jobs_revealer {
      transition-type: slide_up;

      Gtk.Box {
        orientation: vertical;

        Gtk.Box jobs_header {
          visible: false;
          spacing: 12;
          margin-start: 12;
          margin-end: 6;
          margin-top: 6;

          Gtk.Label jobs_label {
            xalign: 0;
            hexpand: true;

            styles [
              "dim-label",
              "caption",
            ]
          }

          Gtk.Button {
            label: _("Cancel All");
            clicked => $on_cancel_all_clicked() swapped;

            styles [
              "flat",
            ]
          }
        }

        // A big batch lists every archive; past a few rows the list scrolls
        // rather than pushing the window's content off the screen. Its
        // height is set in code (update_jobs_header) from the row count.
        Gtk.ScrolledWindow jobs_scroller {
          hscrollbar-policy: never;

          Gtk.Box jobs_box {
            orientation: vertical;
          }
        }
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      Gtk.Stack stack {
        Gtk.StackPage {
          name: "empty";

          child: Adw.StatusPage status_page {
            icon-name: "package-x-generic-symbolic";
            title: _("Open an Archive");
            description: _("Open a .7z, .zip, .tar or other archive to see what's inside, or extract several at once.");

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Button {
                label: _("Open Archive…");
                clicked => $on_open_clicked() swapped;

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Gtk.Button {
                label: _("Extract Several Archives…");
                clicked => $on_batch_extract_clicked() swapped;

                styles [
                  "pill",
                ]
              }
            };
          };
        }

        Gtk.StackPage {
          name: "archive";
          child: $SeptimaArchiveView archive_view {};
        }
      }
    };
  };
}
