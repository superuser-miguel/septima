using Gtk 4.0;
using Adw 1;

template $SeptimaArchiveView: Adw.Bin {
  Gtk.Box {
    orientation: vertical;

    Gtk.Box {
      styles ["toolbar"]

      Gtk.Label summary_label {
        xalign: 0;
        hexpand: true;
        ellipsize: end;
        selectable: true;
      }

      Gtk.Button rename_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Rename Entry");
        sensitive: false;
        clicked => $on_rename_clicked() swapped;
      }

      Gtk.Button delete_button {
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Delete Entries");
        sensitive: false;
        clicked => $on_delete_clicked() swapped;
      }
    }

    Gtk.ScrolledWindow {
      vexpand: true;
      hexpand: true;

      Gtk.ColumnView column_view {
        styles ["data-table"]

        show-column-separators: true;
        show-row-separators: true;
      }
    }
  }
}
